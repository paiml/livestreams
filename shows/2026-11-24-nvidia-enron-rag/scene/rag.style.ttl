@prefix rts: <tag:paiml.com,2026:rts#> .
@prefix ex: <tag:paiml.com,2026:scene:locked#> .

ex:scene a rts:Scene ;
  rts:sceneId "nvidia-enron-rag" ; rts:style rts:DefaultStyle-v1 ;
  rts:geometry ex:geom ; rts:theme ex:theme ; rts:persona ex:persona ;
  rts:beat ex:b1 , ex:b2 , ex:b3 , ex:b4 , ex:b5 , ex:b6 , ex:b7 , ex:b8 , ex:b9 ;
  rts:captureEnv ex:env .

ex:geom rts:frameWidthPx 1920 ; rts:frameHeightPx 1080 ; rts:fps 30 ;
  rts:cols 100 ; rts:rows 32 ; rts:cellWidthPx 12 ; rts:cellHeightPx 24 ;
  rts:insetPx 40 ; rts:windowChrome false .

ex:theme rts:background "#191925" ; rts:foreground "#abb1d2" ;
  rts:fontFamily "DejaVu Sans Mono" ; rts:fontSha256 "b6b1ff4ddefe36d7f2a6174e1d001cab374e594519ee9049af028d577b64c5f5" ;
  rts:colorPairUse ex:cp-0 , ex:cp-1 , ex:cp-2 .
ex:cp-0 rts:fg "#abb1d2" ; rts:bg "#191925" ; rts:contrastRatio 8.24 .
ex:cp-1 rts:fg "#dcb06f" ; rts:bg "#191925" ; rts:contrastRatio 8.68 .
ex:cp-2 rts:fg "#9ec070" ; rts:bg "#191925" ; rts:contrastRatio 8.47 .
ex:persona rts:host "mirasol" ; rts:branch "main" ; rts:cwd "~/examples" ;
  rts:promptGlyph "❯" ; rts:hostColor "#abb1d2" ;
  rts:branchColor "#dcb06f" ; rts:cwdColor "#9ec070" ;
  rts:promptConfigSha256 "9328a7e2a3535eedf6f6530fa7a645242d2d492913e4a63d8586760b02504b3b" .

ex:b1 rts:order 1 ;
  rts:command [ rts:text "pmat query --raw --regex -i --limit 400 'strategic investment|equity investment|financing arrangements' -p . | grep '^enron-10k-fy2000.txt' | head -3 | cut -c1-150" ; rts:charCount 163 ; rts:typingSeed 15447102925914519938 ;
    rts:meanCps 11.73 ;
    rts:minGapMs 31 ; rts:maxGapMs 191 ;
    rts:thinkPauseMs 1491 ; rts:startOffsetMs 19773 ;
    rts:typoCount 0 ; rts:retimeScope rts:EchoOnly ] .

